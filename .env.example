# Copy to .env and adjust. Every setting in app/core/config.py can be set here (upper-case name).

# Shared secret Spring uses to call this service (Authorization: Bearer <token>)
SERVICE_TOKEN=change-me
DATABASE_URL=postgresql+asyncpg://hrd_ai:hrd_ai@localhost:5433/hrd_ai

# --- LLM: Ollama in dev -------------------------------------------------------
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:4b-instruct
LLM_CONTEXT_WINDOW=6144
# --- LLM: vLLM in production (example) ----------------------------------------
# LLM_BASE_URL=http://gpu-server:8000/v1
# LLM_API_KEY=<vllm api key>
# LLM_MODEL=Qwen/Qwen3-8B
# LLM_CONTEXT_WINDOW=32768
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# --- Embeddings (bge-m3) ----------------------------------------------------------
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=ollama
# On a 4 GB GPU keep embeddings on the CPU so the LLM gets the whole GPU. Create the CPU variant once:
#   docker compose exec ollama sh -c "printf 'FROM bge-m3\nPARAMETER num_gpu 0\n' > /tmp/M && ollama create bge-m3-cpu -f /tmp/M"
# (same bge-m3 weights; use EMBED_MODEL=bge-m3 on a bigger GPU)
EMBED_MODEL=bge-m3-cpu
EMBED_DIM=1024

# --- Reranker (bge-reranker-v2-m3 on TEI; for vLLM set RERANK_API=vllm) ---------------
RERANK_ENABLED=true
RERANK_BASE_URL=http://localhost:8081
RERANK_API=tei
RERANK_MIN_SCORE=0.05
# Chunks scored by the reranker. CPU cost on the laptop: 5 -> 6 s, 10 -> 16 s, 20 -> 39 s. Use 20 on a GPU.
RERANK_CANDIDATES=8

# --- OCR: paddle | tesseract | none -----------------------------------------------
OCR_ENGINE=paddle
OCR_STRUCTURE=false
# oneDNN speeds up Paddle on Linux CPUs but fails on Windows with Paddle 3.x - keep false on Windows
OCR_PADDLE_MKLDNN=false

# --- Test UI (Streamlit) ----------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
